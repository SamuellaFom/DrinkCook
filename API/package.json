{
  "name": "drivn-cook-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev": "nodemon -e ts --exec ts-node -r tsconfig-paths/register src/main.ts",
    "start:dev:js": "nodemon -e ts --exec \"tsc && node ./dist/main.js\"",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate src/services/db/migrations/Init-Migration -d src/services/db/database.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/services/db/database.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/services/db/database.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/main.js",
    "fixtures": "node dist/scripts/load-fixtures.js",
    "fixtures:dev": "ts-node -r tsconfig-paths/register src/scripts/load-fixtures.ts",
    "prepare:prod": "npm run migration:run:prod && npm run fixtures",
    "start:prod": "npm run prepare:prod && npm run start",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/services/db/database.js",
    "start:dev:v2": "dotenv -e .env.v2 -- nodemon -e ts --exec ts-node -r tsconfig-paths/register src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.862.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.4.7",
    "express": "~4.16.1",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.9.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.1.0",
    "@types/nodemailer": "^7.0.1",
    "dotenv-cli": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
